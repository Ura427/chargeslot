# Matches the `db` service in docker-compose.yml.
DATABASE_URL=postgresql://chargeslot:chargeslot@localhost:5432/chargeslot
PORT=3000
WEB_ORIGIN=http://localhost:5173

# At least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-32-or-more-characters
JWT_REFRESH_SECRET=replace-with-another-random-string-of-32-or-more-chars
